# AarogyaDamu Production Environment Configuration Example
# Copy this file to .env locally or configure these variables in Vercel Project Settings.

# Public Site Configuration
VITE_PUBLIC_SITE_URL=https://aarogyadamu.com
VITE_PUBLIC_ANALYTICS_ENABLED=false
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase Storage Configuration (Public/Client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# SERVER ONLY — NEVER expose through VITE_* variables or ship to client bundles
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# Optional: Email Service Integration (Server-Side Only)
# Configured in Vercel serverless environment for contact form delivery
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=aarogyadamu@gmail.com
